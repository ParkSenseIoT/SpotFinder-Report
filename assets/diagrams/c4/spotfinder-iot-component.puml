@startuml spotfinder-iot-component
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial

title Component Diagram — IoT Nodes & Edge (SpotFinder)

Person(driver, "Driver", "Conductor que ingresa/sale del estacionamiento")
Container(edge, "Edge Gateway", "Flask / Python (REST)", "API REST + reglas de debounce/umbral (SpotFinder-EdgeGateway)", $tags="Edge")
Container(backend, "Backend API", "Spring Boot", "RESTful API")
System_Ext(plateRecognizer, "Plate Recognizer API", "ALPR", $tags="External")

Container_Boundary(spotNode, "Parking Spot + Barrier Node (ESP32 DevKit)") {
  Component(ultrasonic, "UltrasonicSensor", "C++ / HC-SR04", "Mide distancia y emite VehicleDetected/VehicleLeft")
  Component(statusLeds, "StatusLeds", "C++ / 2 LEDs (verde 32 / rojo 33)", "Guiado visual disponible/ocupado")
  Component(gas, "GasSensor", "C++ / MQ-2", "Lee PPM y emite GasExceeded")
  Component(buzzer, "Buzzer", "C++", "Sirena de evacuación / aviso")
  Component(irIn, "IrSensor (Entrada)", "C++ / FC-51 GPIO14", "Detecta llegada del vehículo a la barrera")
  Component(irOut, "IrSensor (Salida)", "C++ / FC-51 GPIO27", "Confirma paso del vehículo")
  Component(servo, "ServoBarrier", "C++ / SG90 GPIO26", "Abre/cierra la barrera (0°/90°)")
  Component(spotLogic, "ParkingSpot+BarrierNode", "C++ / Device", "Orquesta sensores/actuadores del slot y la barrera")
  Component(edgeClient, "EdgeClient", "C++ / HTTPClient", "Cliente HTTP/REST hacia el Edge (X-API-Key)")
}

Container_Boundary(cameraNode, "Plate Camera Node (ESP32-CAM, OV3660)") {
  Component(camera, "Camera (OV3660)", "C++ / ESP32-CAM", "Captura imagen de placa para ALPR")
  Component(camLogic, "PlateCameraNode", "C++ / Device", "Captura periódica y envío al Edge")
  Component(camEdgeClient, "EdgeClient", "C++ / HTTPClient", "POST /access/plate (base64, X-API-Key)")
}

Rel(driver, irIn, "Llega a la barrera de entrada")
Rel(driver, irOut, "Llega a la barrera de salida")

Rel(ultrasonic, spotLogic, "VehicleDetected / VehicleLeft", "Event")
Rel(gas, spotLogic, "GasExceeded", "Event")
Rel(spotLogic, statusLeds, "SetGreen / SetRed", "Command")
Rel(spotLogic, buzzer, "Siren / Beep", "Command")
Rel(spotLogic, edgeClient, "postOccupancy / postGas", "Call")
Rel(edgeClient, edge, "POST /monitoring/sensor-readings, /monitoring/gas-analysis", "HTTP/REST")

Rel(camera, camLogic, "Frame JPEG", "Event")
Rel(camLogic, camEdgeClient, "sendPlate(base64)", "Call")
Rel(camEdgeClient, edge, "POST /access/plate", "HTTP/REST")
Rel(edge, backend, "Reenvía la placa: POST /access/entries", "HTTP/REST")
Rel(backend, plateRecognizer, "Reenvía imagen para ALPR", "HTTPS")

Rel(irIn, spotLogic, "ObstacleDetected", "Event")
Rel(irOut, spotLogic, "ObstacleDetected", "Event")
Rel(spotLogic, edgeClient, "barrierShouldOpen()", "Call")
Rel(edgeClient, edge, "GET /access/barrier -> {OPEN|IDLE}", "HTTP/REST")
Rel(spotLogic, servo, "Open / Close (si comando OPEN)", "Command")
Rel(edge, backend, "Reenvía lecturas consolidadas de monitoreo", "HTTP/REST")

SHOW_LEGEND()
@enduml
