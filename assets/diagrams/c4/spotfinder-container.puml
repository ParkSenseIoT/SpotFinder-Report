@startuml spotfinder-container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial

title Container Diagram — SpotFinder (con dispositivos IoT)

Person(driver, "Driver", "Conductor")
Person(admin, "Parking Administrator", "Administrador del estacionamiento")

System_Ext(plateRecognizer, "Plate Recognizer API", "ALPR", $tags="External")
System_Ext(culqi, "Culqi", "Pasarela de pagos", $tags="External")
System_Ext(fcm, "Firebase Cloud Messaging", "Push", $tags="External")

System_Boundary(spotfinder, "SpotFinder") {
  Container(landing, "Landing Page", "HTML5 / CSS3 / JS", "Sitio estático con propuesta de valor y planes", $tags="Browser")
  Container(mobile, "Mobile App", "Flutter / Dart", "App del conductor: mapa, reservas, pagos, Find My Car, Wallet", $tags="MobileApp")
  Container(web, "Web Dashboard", "Angular + Angular Material", "Dashboard admin: monitoreo, accesos, emergencias, reportes, usuarios", $tags="Browser")
  Container(backend, "Backend API", "Spring Boot 4 / Java 21", "RESTful API con 8 bounded contexts (IAM, Parking Monitoring, Access Control, Payment, Emergency, Analytics, Notification, Reservation)")
  Container(edge, "Edge Gateway", "Flask / Python (REST)", "Recibe lecturas HTTP/REST de los nodos (SpotFinder-EdgeGateway), aplica debounce/umbrales y reenvía al backend", $tags="Edge")
  ContainerDb(db, "Database", "MySQL 8 (InnoDB)", "Esquema único 'spotfinder' con tablas por bounded context", $tags="Database")

  Container(spotNode, "Parking Spot + Barrier Node", "ESP32 DevKit / C++", "HC-SR04 (ocupación) + 2 LEDs (verde/rojo) + MQ-2 (gas) + buzzer + 2x IR (entrada/salida) + servo SG90 (barrera)", $tags="IoT")
  Container(cameraNode, "Plate Camera Node", "ESP32-CAM (OV3660) / C++", "Solo cámara: captura la placa y la envía al Edge para ALPR", $tags="IoT")
}

Rel(driver, mobile, "Usa la app", "HTTPS, JWT")
Rel(driver, landing, "Consulta", "HTTPS")
Rel(admin, web, "Usa el dashboard", "HTTPS, JWT")

Rel(mobile, backend, "Consume servicios REST", "JSON/HTTPS")
Rel(web, backend, "Consume servicios REST", "JSON/HTTPS")
Rel(backend, db, "Lee/escribe vía JPA", "JDBC / MySQL")
Rel(backend, plateRecognizer, "ALPR", "HTTPS")
Rel(backend, culqi, "Pagos", "HTTPS")
Rel(backend, fcm, "Notificaciones push", "HTTPS")
Rel(backend, web, "Actualizaciones en tiempo real", "WebSocket")

Rel(cameraNode, edge, "Envía imagen de placa (base64) cada ~2.5 s", "HTTP/REST POST /access/plate")
Rel(spotNode, edge, "Publica ocupación/gas y consulta el comando de barrera (OPEN/IDLE)", "HTTP/REST")
Rel(edge, backend, "Reenvía lecturas consolidadas y la placa para ALPR", "HTTP/REST")

SHOW_LEGEND()
@enduml
